NODE_ENV=production
PORT=3000
# Hosting provider should inject DATABASE_URL from its managed PostgreSQL database.
DATABASE_URL=
# Generate a random secret of at least 32 characters; never reuse this example.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
ADMIN_NAME=Company Administrator
# Optional: comma-separated allowed frontend origins. Leave unset if frontend is served by this same app.
CLIENT_URL=
# Optional email integration. Configure only if needed.
SENDGRID_API_KEY=
ALERT_EMAIL=
